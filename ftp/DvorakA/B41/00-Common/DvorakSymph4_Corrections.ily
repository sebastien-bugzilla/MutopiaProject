%  work        : Symphony No. 4 in D Minor Op.13 (B.41)
%  typesetter  : Sébastien MANEN
%  date        : Sunday 04 January 2026, 08:21
%###############################################################################
%#                     C O R R E C T I O N   S E C T I O N                     #
%###############################################################################
correctionsMvtI = \markup {
	
	% bar 340, Oboe
	"Bar 340, Oboe I : a sharp on first beat is added (similarly to Flauti)."
	
	% bar 108 and 128, Cor I II
	"Bar 108 and 128, for Corni I II : a F clef is replaced by a G clef (based on part score)."
	
	% bar 39, Viola
	"Bar 39, for Viola, on second beat <f ais> is indicated but it's more probably <fis a> as in bar 35."
	
	% bar 125, Viola
	"Bar 125, for Viola, a missing "pizz." indication is added."
	
	% bar 351, Violin II
	"Bar 351, For violin II, a missing hairpin is added."
}
correctionsMvtII = \markup {
	
	% bar 105
	"Bar 105, for clarinetto I, on the last beat a missing bes is indicated based on Fl.I."
	
	% bar 31, cello
	"Bar 31, for Cello, second voice, a missing dot on the bes minim is added."
}
correctionsMvtIII = \markup {
	
	% bar 166, clarinette II
	"Bar 166, for Clarinette II, a missing natural is added on first note."
	
	% bar 110, timpani
	"Bar 110, for timpani, the missing indication of tune modification A => H is added."
	
	% bar 140, timpani
	"Bar 140, for timpani, the missing indication of tune modification H,D => C,G is added."
}
correctionsMvtIV = \markup {
	
	% bar 26, all
	"The indication of bar numbers are shifted of one unit from bar 25 to the end of the score. Bar number 25, is in fact bar 26. The present edition correct this."
	
	% bar 648 (649), oboe I
	"Bar 648 (649), for oboe I, the rhythm is corrected based on part score."
	
	% bar 129, Violin I
	"Bar 129 (128), for violin I, a missing flat is added on the a."
	
	% bar 634, violin II
	"Bar 634 (633), for violin II, last three notes cis d e are replace by d e fis based on all other strings."
}
