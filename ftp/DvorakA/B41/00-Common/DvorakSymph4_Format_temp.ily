displayFilterVoice = {
\set Score.skipTypesetting = ##t  \set Score.currentBarNumber = #1
\set Score.skipTypesetting = ##f s1.*139 s2*126 s1.*75 s2*24
\set Score.skipTypesetting = ##t s2*25
}
