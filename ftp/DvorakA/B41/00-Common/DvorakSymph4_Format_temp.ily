displayFilterVoice = {

\set Score.skipTypesetting = ##f 
\set Score.skipTypesetting = ##t 
}
formatPiattiMvtI = {
%\override Score.NonMusicalPaperColumn.line-break-permission = ##f
\override Score.NonMusicalPaperColumn.page-break-permission = ##f

\overrideProperty Score.NonMusicalPaperColumn.line-break-system-details #'((Y-offset . 8.05))  s2.*127 \break
\overrideProperty Score.NonMusicalPaperColumn.line-break-system-details #'((Y-offset . 22.58))  s2.*124 s2*3 s2.*121 s2*4 \break
\overrideProperty Score.NonMusicalPaperColumn.line-break-system-details #'((Y-offset . 33.82))  s2.*67 
}
