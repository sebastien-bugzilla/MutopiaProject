displayFilterVoice = {
\set Score.skipTypesetting = ##t  \set Score.currentBarNumber = #1
\set Score.skipTypesetting = ##f s2.*161
\set Score.skipTypesetting = ##t s2.*91 s2*3 s2.*121 s2*4 s2.*67
}
