	\overrideProperty Score.NonMusicalPaperColumn.line-break-system-details #'(
		(Y-offset . 10)
		(alignment-distances . (10 11 9.5 10 9 12 9.5 9 9.5 8.5 9.5 12 10 12 8.5 9 8.5 9.5)))
	s2*9 \pageBreak
}
