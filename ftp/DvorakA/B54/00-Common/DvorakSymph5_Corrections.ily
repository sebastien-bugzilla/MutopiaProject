correctionsMvtI = \markup {
	
	% bar 81, faggot I & II
	"In Mvt I, bar 81, for faggot I & II, a missing flat is printed for the e. It is present in part score and confirmed also for cellos and bass."
}
correctionMvtII = \markup {
	
	% bar 33, Clarinette I
	"In Mvt II, bar 33, for clarinette I, the rhythm is not correct on the second beat. Instead of three 16th, a 16th and 2 32th is printed as mentionned in part score."
}
